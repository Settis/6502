VARIABLE SEED

: RND_INIT ( -- )
    BEGIN
        UPTIMEMS +
        DUP SEED !
    UNTIL
;

: RND ( -- n )
    SEED @
    DUP 7 >> XOR
    DUP 9 << XOR
    DUP 13 >> XOR
    DUP SEED !
;

: RND_I  ( n -- n )
    RND SWAP /MOD DROP ABS
;

VGA_INIT

: GEN_POS ( -- X Y )
    35 RND_I
    216 RND_I
;

: HP_DEMO 
    RND_INIT
    BEGIN
        0 VGA_FILL
        GEN_POS SNITCH
        GEN_POS HP_KEY
        GEN_POS HEDWIG
        GEN_POS HP
        GEN_POS PLATFORM

        1000 0 DO 
            1000 0 DO
            LOOP
        LOOP

    AGAIN
;

HP_DEMO
